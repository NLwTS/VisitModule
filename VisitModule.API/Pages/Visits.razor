@page "/visits"
@using VisitModule.Domain.Model
@using VisitModule.Infrastructure.Data
@using VisitModule.Domain
@using Microsoft.EntityFrameworkCore
@inject VisitContext DbContext

<h3>Список визитов</h3>

<!-- Фильтры: поиск, выбор дат -->
<div class="mb-3">
    <input type="text" class="form-control mb-2" placeholder="Поиск по фамилии или ID студента" @bind="searchTerm" @oninput="OnSearchChanged" />
</div>

<!-- Фильтр по типу -->
<div class="mb-3">
    <label class="form-check">
        <input type="checkbox" class="form-check-input" @bind="showEntrances" />
        <span class="form-check-label">Показать только входы</span>
    </label>
    <label class="form-check">
        <input type="checkbox" class="form-check-input" @bind="showExits" />
        <span class="form-check-label">Показать только выходы</span>
    </label>
</div>


<!-- Кнопка обновления -->
<div class="mb-3">
    <button class="btn btn-primary" @onclick="RefreshVisits">Обновить список</button>
</div>

@if (visits == null)
{
    <p>Загрузка...</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th @onclick="() => SortTable(nameof(Visit.Type))">Тип прохода @GetSortArrow(nameof(Visit.Type))</th>
                <th @onclick="() => SortTable(nameof(Visit.Student.StudentFirstName))">Имя @GetSortArrow(nameof(Visit.Student.StudentFirstName))</th>
                <th @onclick="() => SortTable(nameof(Visit.Student.StudentSecondName))">Фамилия @GetSortArrow(nameof(Visit.Student.StudentSecondName))</th>
                <th @onclick="() => SortTable(nameof(Visit.Location))">Локация @GetSortArrow(nameof(Visit.Location))</th>
                <th @onclick="() => SortTable(nameof(Visit.VisitDate))">Дата прохода @GetSortArrow(nameof(Visit.VisitDate))</th>
                <th @onclick="() => SortTable(nameof(Visit.VisitTime))">Время прохода @GetSortArrow(nameof(Visit.VisitTime))</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var visit in visits)
            {
                <tr>
                    <td>@visit.Type</td>
                    <td>@visit.Student?.StudentFirstName</td>
                    <td>@visit.Student?.StudentSecondName</td>
                    <td>@visit.Location</td>
                    <td>@visit.VisitDate.ToString("dd-MM-yyyy")</td>
                    <td>@visit.VisitTime.ToString()</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Visit> visits;
    private string currentSortColumn;
    private bool isAscending = true;
    private string searchTerm = string.Empty; // Текущий текст поиска
    private bool showEntrances = false; // Фильтр: только входы
    private bool showExits = false;     // Фильтр: только выходы

    // Метод для загрузки данных о визитах с фильтрацией и сортировкой
    protected override async Task OnInitializedAsync()
    {
        await LoadVisitsAsync();
    }

    private async Task LoadVisitsAsync()
    {
        var query = DbContext.Visits.Include(v => v.Student).AsQueryable();

        // Фильтрация по фамилии или ID студента
        if (!string.IsNullOrEmpty(searchTerm))
        {
            query = query.Where(v => v.Student.StudentSecondName.Contains(searchTerm) ||
                                      v.Student.StudentListId.ToString().Contains(searchTerm));
        }

        // Фильтрация по типу входа/выхода
        if (showEntrances && !showExits)
        {
            query = query.Where(v => v.Type == "Вход");
        }
        else if (!showEntrances && showExits)
        {
            query = query.Where(v => v.Type == "Выход");
        }

        // Применяем сортировку
        if (!string.IsNullOrEmpty(currentSortColumn))
        {
            switch (currentSortColumn)
            {
                case nameof(Visit.Type):
                    query = isAscending ? query.OrderBy(v => v.Type) : query.OrderByDescending(v => v.Type);
                    break;
                case nameof(Visit.Student.StudentFirstName):
                    query = isAscending ? query.OrderBy(v => v.Student.StudentFirstName) : query.OrderByDescending(v => v.Student.StudentFirstName);
                    break;
                case nameof(Visit.Student.StudentSecondName):
                    query = isAscending ? query.OrderBy(v => v.Student.StudentSecondName) : query.OrderByDescending(v => v.Student.StudentSecondName);
                    break;
                case nameof(Visit.Location):
                    query = isAscending ? query.OrderBy(v => v.Location) : query.OrderByDescending(v => v.Location);
                    break;
                case nameof(Visit.VisitDate):
                    query = isAscending ? query.OrderBy(v => v.VisitDate) : query.OrderByDescending(v => v.VisitDate);
                    break;
                case nameof(Visit.VisitTime):
                    query = isAscending ? query.OrderBy(v => v.VisitTime) : query.OrderByDescending(v => v.VisitTime);
                    break;
            }
        }

        visits = await query.ToListAsync();
    }

    // Метод для сортировки по столбцам
    private async void SortTable(string columnName)
    {
        if (currentSortColumn == columnName)
        {
            isAscending = !isAscending;
        }
        else
        {
            currentSortColumn = columnName;
            isAscending = true;
        }

        await LoadVisitsAsync();
    }

    // Метод для отображения стрелки сортировки
    private string GetSortArrow(string columnName)
    {
        if (currentSortColumn != columnName) return string.Empty;
        return isAscending ? "↑" : "↓";
    }

    // Метод для обработки изменения текста в поле поиска
    private async void OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        await LoadVisitsAsync();
    }

    // Метод для обработки изменения фильтра типа
    private async void OnTypeFilterChanged(ChangeEventArgs e)
    {
        await LoadVisitsAsync();
    }

    private async Task OnFilterChanged()
    {
        await LoadVisitsAsync();
    }

    private bool ShowEntrances
    {
        get => showEntrances;
        set
        {
            if (showEntrances != value)
            {
                showEntrances = value;
                _ = OnFilterChanged();
            }
        }
    }

    private bool ShowExits
    {
        get => showExits;
        set
        {
            if (showExits != value)
            {
                showExits = value;
                _ = OnFilterChanged();
            }
        }
    }
    // Метод для ручного обновления списка
    private async Task RefreshVisits()
    {
        await LoadVisitsAsync();
    }
}
